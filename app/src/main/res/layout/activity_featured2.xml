<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Featured2">


    <ImageView
        android:id="@+id/imageView113"
        android:layout_width="wrap_content"
        android:layout_height="500dp"
        android:layout_marginBottom="316dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/mainfeatured2" />

    <ImageView
        android:id="@+id/imageView115"
        android:layout_width="395dp"
        android:layout_height="500dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.992"
        app:srcCompat="@drawable/rectangle4" />

    <TextView
        android:id="@+id/textView135"
        android:layout_width="331dp"
        android:layout_height="85dp"
        android:fontFamily="@font/changa"
        android:text="HAVE A SMOOTH JOURNEY WITH DOCUMENT MANAGER"
        android:textAlignment="center"
        android:textColor="#C38A65"
        android:textSize="25dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView115"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView115"
        app:layout_constraintVertical_bias="0.161" />

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="596dp"
        android:background="@drawable/rocks"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


    </LinearLayout>


    <ImageButton
        android:id="@+id/Main2Btn"
        android:layout_width="354dp"
        android:layout_height="121dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/imageView115"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.589"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.717"
        app:srcCompat="@drawable/rectangle8" />

    <TextView
        android:id="@+id/textView117"
        android:layout_width="354dp"
        android:layout_height="121dp"
        android:fontFamily="@font/changa_extralight"
        android:text="Store your travel documents together for easy reference and to fully enjoy your adventure"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/Main2Btn"
        app:layout_constraintEnd_toEndOf="@+id/Main2Btn"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/Main2Btn"
        app:layout_constraintTop_toTopOf="@+id/Main2Btn"
        app:layout_constraintVertical_bias="1.0" />

    <ImageView
        android:id="@+id/imageView248"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/Main2Btn"
        app:layout_constraintEnd_toEndOf="@+id/Main2Btn"
        app:layout_constraintHorizontal_bias="0.784"
        app:layout_constraintStart_toStartOf="@+id/Main2Btn"
        app:layout_constraintTop_toBottomOf="@+id/imageView113"
        app:layout_constraintVertical_bias="0.809"
        app:srcCompat="@drawable/baseline_arrow_forward_ios_24" />

</androidx.constraintlayout.widget.ConstraintLayout>