<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Featured3">

    <ImageView
        android:id="@+id/imageView95"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="204dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/mainfeatured3" />

    <ImageView
        android:id="@+id/imageView98"
        android:layout_width="393dp"
        android:layout_height="485dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.996"
        app:srcCompat="@drawable/rectangle4" />


    <TextView
        android:id="@+id/textView137"
        android:layout_width="331dp"
        android:layout_height="85dp"
        android:fontFamily="@font/changa"
        android:text="PERSONALIZE YOUR TRAVEL EXPERIENCE"
        android:textAlignment="center"
        android:textColor="#C38A65"
        android:textSize="25dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView98"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView98"
        app:layout_constraintVertical_bias="0.16" />

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="592dp"
        android:background="@drawable/buildings"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


    </LinearLayout>


    <ImageButton
        android:id="@+id/Main3Btn"
        android:layout_width="329dp"
        android:layout_height="125dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/imageView98"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.487"
        app:layout_constraintStart_toStartOf="@+id/imageView98"
        app:layout_constraintTop_toBottomOf="@+id/textView137"
        app:layout_constraintVertical_bias="0.088"
        app:srcCompat="@drawable/rectangle8" />

    <TextView
        android:id="@+id/textView139"
        android:layout_width="302dp"
        android:layout_height="125dp"
        android:fontFamily="@font/changa_extralight"
        android:text="Plan your own itinerary, choose your own adventure, and enjoy it your way"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/Main3Btn"
        app:layout_constraintEnd_toEndOf="@+id/Main3Btn"
        app:layout_constraintHorizontal_bias="0.518"
        app:layout_constraintStart_toStartOf="@+id/Main3Btn"
        app:layout_constraintTop_toTopOf="@+id/Main3Btn"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/imageView66"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView95"
        app:layout_constraintEnd_toEndOf="@+id/textView139"
        app:layout_constraintHorizontal_bias="0.720"
        app:layout_constraintStart_toStartOf="@+id/textView139"
        app:layout_constraintTop_toTopOf="@+id/textView139"
        app:layout_constraintVertical_bias="0.680"
        app:srcCompat="@drawable/baseline_arrow_forward_ios_24" />
</androidx.constraintlayout.widget.ConstraintLayout>